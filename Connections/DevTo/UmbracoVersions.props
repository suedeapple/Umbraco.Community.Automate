<Project>
  <!--
    Umbraco 17 and 18 both run on net10.0, so one build serves both: compiled against the lowest
    supported versions, published with ranges that stop short of 19. -p:UmbracoMajor=18 builds,
    tests and runs the demo against 18. Applied with VersionOverride, so the rest of the monorepo
    keeps its pins.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">17</UmbracoMajor>
  </PropertyGroup>

  <!-- Floors are what Umbraco.Automate.Core 17.0.0 itself requires. -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoCmsVersionRange>[17.4.0, 19.0.0)</UmbracoCmsVersionRange>
    <UmbracoAutomateVersionRange>[17.0.0, 19.0.0)</UmbracoAutomateVersionRange>
    <UmbracoAutomateTestingVersion>17.0.0</UmbracoAutomateTestingVersion>
    <UmbracoCmsDemoVersion>17.7.0</UmbracoCmsDemoVersion>
    <UmbracoAutomateDemoVersion>17.4.0</UmbracoAutomateDemoVersion>
    <CleanDemoVersion>7.0.8</CleanDemoVersion>
  </PropertyGroup>

  <!-- Compatibility build only; never packed. -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoCmsVersionRange>[18.2.0, 19.0.0)</UmbracoCmsVersionRange>
    <UmbracoAutomateVersionRange>[18.4.0, 19.0.0)</UmbracoAutomateVersionRange>
    <UmbracoAutomateTestingVersion>18.4.0</UmbracoAutomateTestingVersion>
    <UmbracoCmsDemoVersion>18.2.0</UmbracoCmsDemoVersion>
    <UmbracoAutomateDemoVersion>18.4.0</UmbracoAutomateDemoVersion>
    <CleanDemoVersion>8.0.1</CleanDemoVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Target Name="CheckUmbracoMajor" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(UmbracoMajor)' != '17' And '$(UmbracoMajor)' != '18'">
    <Error Text="UmbracoMajor must be 17 or 18 (was '$(UmbracoMajor)')." />
  </Target>
</Project>
