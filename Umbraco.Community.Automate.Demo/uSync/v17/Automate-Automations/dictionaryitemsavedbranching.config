<?xml version="1.0" encoding="utf-8"?>
<Automation Key="c3a8696c-2949-4c4e-889c-8b4f314b2c58" Alias="dictionaryItemSavedBranching" Level="0">
  <Info>
    <Name>Branch on an outcome (Kitchen Sink example)</Name>
    <Description>When a dictionary item is saved, sends its key to httpbin.org, then checks a status and takes a different path for each outcome. Shows a custom trigger, outputs and outcomes. Works without any signup.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="community.examples.kitchenSink.dictionaryItemSaved">
    <Settings><![CDATA[{}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="0fccf0d9-72e7-4f02-8b50-1748ee4dded0" ActionAlias="umbracoAutomate.logMessage">
      <Name>Log not found</Name>
      <Alias>logNotFound</Alias>
      <Connection />
      <Position X="250" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "logLevel": "Warning",
  "message": "Status ${ steps.checkStatus.statusCode }: not found"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="2473a589-b618-408e-a49b-a9cf3fd1bf99" ActionAlias="community.examples.kitchenSink.checkStatus">
      <Name>Check Example Status</Name>
      <Alias>checkStatus</Alias>
      <Connection>examples-kitchenSink</Connection>
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "statusCode": 200
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="80317f91-350b-4ff3-a746-caac93e59142" ActionAlias="community.examples.kitchenSink.sendMessage">
      <Name>Send Example Message</Name>
      <Alias>sendMessage</Alias>
      <Connection>examples-kitchenSink</Connection>
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "message": "Saved ${ trigger.key }"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="bc50323a-6da9-4536-97b0-afa0a0986cfe" ActionAlias="umbracoAutomate.logMessage">
      <Name>Log available</Name>
      <Alias>logAvailable</Alias>
      <Connection />
      <Position X="250" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "logLevel": "Information",
  "message": "Status ${ steps.checkStatus.statusCode }: available"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="80317f91-350b-4ff3-a746-caac93e59142">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="2473a589-b618-408e-a49b-a9cf3fd1bf99" Target="0fccf0d9-72e7-4f02-8b50-1748ee4dded0">
      <SourceHandle>notFound</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>notFound</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="2473a589-b618-408e-a49b-a9cf3fd1bf99" Target="bc50323a-6da9-4536-97b0-afa0a0986cfe">
      <SourceHandle>available</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>available</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="80317f91-350b-4ff3-a746-caac93e59142" Target="2473a589-b618-408e-a49b-a9cf3fd1bf99">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences>
    <Connection Alias="examples-kitchenSink" Type="community.examples.kitchenSink" Name="Kitchen Sink Example (httpbin.org)" />
  </ConnectionReferences>
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>