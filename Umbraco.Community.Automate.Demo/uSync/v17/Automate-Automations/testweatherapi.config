<?xml version="1.0" encoding="utf-8"?>
<Automation Key="e2737e6f-1f04-4885-a8a8-193d215b0887" Alias="testWeatherApi" Level="0">
  <Info>
    <Name>Test: WeatherAPI.com</Name>
    <Description>Starts when the WeatherAPI.com page under "Automate tests" is published, and shows a message on screen to prove it. Add the WeatherAPI.com action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "be0d93b6-78e5-44b4-923d-c0c52e39024f"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="0bb709dd-03b0-4260-8252-fd542b0e4e1c" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the WeatherAPI.com test page started this automation, so the trigger is wired up. Add the WeatherAPI.com action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: WeatherAPI.com ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="0bb709dd-03b0-4260-8252-fd542b0e4e1c">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>