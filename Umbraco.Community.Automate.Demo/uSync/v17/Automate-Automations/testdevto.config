<?xml version="1.0" encoding="utf-8"?>
<Automation Key="98dbb67c-c908-4dc0-a0b5-b46250af11b6" Alias="testDevto" Level="0">
  <Info>
    <Name>Test: DEV Community</Name>
    <Description>Starts when the DEV Community page under "Automate tests" is published, and shows a message on screen to prove it. Add the DEV Community action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "26002030-a56d-437a-aeda-a4e6750fc3f2"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="59e41ab9-b37d-464b-97a2-16be54bbc295" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the DEV Community test page started this automation, so the trigger is wired up. Add the DEV Community action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: DEV Community ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="59e41ab9-b37d-464b-97a2-16be54bbc295">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>