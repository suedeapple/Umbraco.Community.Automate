<?xml version="1.0" encoding="utf-8"?>
<Automation Key="7105d825-328b-42f6-9321-a2a81b387025" Alias="testExamplesSimple" Level="0">
  <Info>
    <Name>Test: Simple Example (httpbin.org)</Name>
    <Description>Starts when the Simple Example (httpbin.org) page under "Automate tests" is published, and shows a message on screen to prove it. Add the Simple Example (httpbin.org) action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "6f2e516c-369a-4fab-b8fa-42e358f4b434"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="e1f8051e-19a4-4363-ae62-79b244fd6b7c" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the Simple Example (httpbin.org) test page started this automation, so the trigger is wired up. Add the Simple Example (httpbin.org) action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: Simple Example (httpbin.org) ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="e1f8051e-19a4-4363-ae62-79b244fd6b7c">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>