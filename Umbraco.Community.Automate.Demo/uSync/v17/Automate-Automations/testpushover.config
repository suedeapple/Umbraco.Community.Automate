<?xml version="1.0" encoding="utf-8"?>
<Automation Key="fc86e833-07e9-41c8-986f-3d04952c3e8d" Alias="testPushover" Level="0">
  <Info>
    <Name>Test: Pushover</Name>
    <Description>Starts when the Pushover page under "Automate tests" is published, and shows a message on screen to prove it. Add the Pushover action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "fd74aa8e-0aa3-463d-ac68-a21d02fe7ac5"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="9fe22a83-dc74-4d45-9258-3bd6107d95b9" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the Pushover test page started this automation, so the trigger is wired up. Add the Pushover action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: Pushover ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="9fe22a83-dc74-4d45-9258-3bd6107d95b9">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>