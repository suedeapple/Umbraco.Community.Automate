<?xml version="1.0" encoding="utf-8"?>
<Automation Key="95cb37ee-bb2c-4300-8cb9-1d3ab92653bb" Alias="testMastodon" Level="0">
  <Info>
    <Name>Test: Mastodon</Name>
    <Description>Starts when the Mastodon page under "Automate tests" is published, and shows a message on screen to prove it. Add the Mastodon action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "4462a55e-0ec4-46cb-bc0f-e3adc10de098"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="07ac588b-37b7-4179-af6f-838ba70a3739" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the Mastodon test page started this automation, so the trigger is wired up. Add the Mastodon action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: Mastodon ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="07ac588b-37b7-4179-af6f-838ba70a3739">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>