<?xml version="1.0" encoding="utf-8"?>
<Automation Key="830bb232-6cd7-473c-954a-48a310b2dd9e" Alias="testGoogleSheets" Level="0">
  <Info>
    <Name>Test: Google Sheets</Name>
    <Description>Starts when the Google Sheets page under "Automate tests" is published, and shows a message on screen to prove it. Add the Google Sheets action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "f1fb3f25-2345-45f2-a4b3-c15f7394f5f7"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="005c88e9-e2f2-4ddc-99ea-863e52d08fce" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the Google Sheets test page started this automation, so the trigger is wired up. Add the Google Sheets action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: Google Sheets ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="005c88e9-e2f2-4ddc-99ea-863e52d08fce">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>