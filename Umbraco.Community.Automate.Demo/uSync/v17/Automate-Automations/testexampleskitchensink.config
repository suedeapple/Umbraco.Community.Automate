<?xml version="1.0" encoding="utf-8"?>
<Automation Key="94816e51-5de8-4bbb-af2e-6cb1d1f22b65" Alias="testExamplesKitchenSink" Level="0">
  <Info>
    <Name>Test: Kitchen Sink Example (httpbin.org)</Name>
    <Description>Starts when the Kitchen Sink Example (httpbin.org) page under "Automate tests" is published, and shows a message on screen to prove it. Add the Kitchen Sink Example (httpbin.org) action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "db0353b7-e77f-490d-a7f9-a27f9015b842"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="1d838337-0fb9-4976-a526-3a2ea3631ac5" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the Kitchen Sink Example (httpbin.org) test page started this automation, so the trigger is wired up. Add the Kitchen Sink Example (httpbin.org) action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: Kitchen Sink Example (httpbin.org) ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="1d838337-0fb9-4976-a526-3a2ea3631ac5">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>