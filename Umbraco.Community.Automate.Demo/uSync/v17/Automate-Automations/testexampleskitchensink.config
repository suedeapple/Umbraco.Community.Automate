<?xml version="1.0" encoding="utf-8"?>
<Automation Key="94816e51-5de8-4bbb-af2e-6cb1d1f22b65" Alias="testExamplesKitchenSink" Level="0">
  <Info>
    <Name>Test: Kitchen Sink Example (httpbin.org)</Name>
    <Description>Starts when the Kitchen Sink Example (httpbin.org) page under "Automate tests" is published, tests the examples-kitchenSink connection, and tells you on screen whether it works. Add the Kitchen Sink Example (httpbin.org) actions you want to try after "Connection works".</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "db0353b7-e77f-490d-a7f9-a27f9015b842"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="289bd6a6-94b7-4b1a-9ec0-232f08115df9" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection works</Name>
      <Alias>connectionWorks</Alias>
      <Connection />
      <Position X="50" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "${ steps.testConnection.message }",
  "severity": "Positive",
  "title": "Kitchen Sink Example (httpbin.org) is connected"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="b9252301-a2b6-4bb6-b25f-e46879759f85" ActionAlias="demo.testConnection">
      <Name>Test Connection</Name>
      <Alias>testConnection</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "connectionAlias": "examples-kitchenSink"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="c391cff2-e9b5-4b68-9a09-51a354b9680a" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection failed</Name>
      <Alias>connectionFailed</Alias>
      <Connection />
      <Position X="450" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "The examples-kitchenSink connection didn\u0027t work: ${ steps.testConnection.message }",
  "severity": "Danger",
  "title": "Kitchen Sink Example (httpbin.org) test failed"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="b9252301-a2b6-4bb6-b25f-e46879759f85">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="b9252301-a2b6-4bb6-b25f-e46879759f85" Target="289bd6a6-94b7-4b1a-9ec0-232f08115df9">
      <SourceHandle>connected</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>connected</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="b9252301-a2b6-4bb6-b25f-e46879759f85" Target="c391cff2-e9b5-4b68-9a09-51a354b9680a">
      <SourceHandle>failed</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>failed</Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>