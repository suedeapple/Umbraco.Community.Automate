<?xml version="1.0" encoding="utf-8"?>
<Automation Key="333d15e4-8995-495c-807f-777c8041a504" Alias="testSkoda" Level="0">
  <Info>
    <Name>Test: Škoda</Name>
    <Description>Starts when the Škoda page under "Automate tests" is published, and shows a message on screen to prove it. Add the Škoda action you want to try after the Notify Editor step, then publish the page again.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "b14778ac-2a22-4038-8e45-0aad29ac2131"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="7047ac49-fef7-4b16-b194-10548f26fae4" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Notify Editor</Name>
      <Alias>notifyEditor</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "Publishing the \u0160koda test page started this automation, so the trigger is wired up. Add the \u0160koda action you want to try after this step.",
  "severity": "Positive",
  "title": "Test: \u0160koda ran"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="7047ac49-fef7-4b16-b194-10548f26fae4">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>