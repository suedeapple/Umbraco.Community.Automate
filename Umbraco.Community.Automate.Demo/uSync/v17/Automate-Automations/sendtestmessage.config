<?xml version="1.0" encoding="utf-8"?>
<Automation Key="fede3528-ee5b-423a-9dc6-1694d47e6550" Alias="sendTestMessage" Level="0">
  <Info>
    <Name>Send a test message (Simple example)</Name>
    <Description>Sends a message to httpbin.org with the Simple example and logs what came back. Works without any signup: open it and click Run, then look under Runs.</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.manual">
    <Settings><![CDATA[{}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="0254d6f0-6c75-45f2-aae6-c4f395d2be38" ActionAlias="umbracoAutomate.logMessage">
      <Name>Log Message</Name>
      <Alias>logMessage</Alias>
      <Connection />
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "logLevel": "Information",
  "message": "httpbin.org received \u0022${ steps.sendMessage.message }\u0022 at ${ steps.sendMessage.receivedAt }"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="3f00063e-2339-4c59-9aa1-f3bf722fd33d" ActionAlias="community.examples.simple.sendMessage">
      <Name>Send Message (Simple Example)</Name>
      <Alias>sendMessage</Alias>
      <Connection>examples-simple</Connection>
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "message": "Hello from the Umbraco Automate Demo site"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="3f00063e-2339-4c59-9aa1-f3bf722fd33d">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="3f00063e-2339-4c59-9aa1-f3bf722fd33d" Target="0254d6f0-6c75-45f2-aae6-c4f395d2be38">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences>
    <Connection Alias="examples-simple" Type="community.examples.simple" Name="Simple Example (httpbin.org)" />
  </ConnectionReferences>
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>