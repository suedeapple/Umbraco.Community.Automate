<?xml version="1.0" encoding="utf-8"?>
<Automation Key="351d5166-31a7-4b5e-aeb0-e5ea811b6f67" Alias="notifyOnPublish" Level="0">
  <Info>
    <Name>Notify me when a page is published (Pushover)</Name>
    <Description>Sends a Pushover notification for every published page. Needs your own Pushover keys in appsettings.Local.json; then publish this automation.</Description>
    <Status>Draft</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="c98eddc7-c881-4223-a4bc-3512b707c035" ActionAlias="community.pushover.sendNotification">
      <Name>Send Pushover Notification</Name>
      <Alias>sendNotification</Alias>
      <Connection>pushover</Connection>
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "message": "${ trigger.contentName } was published",
  "title": "Page published"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="c98eddc7-c881-4223-a4bc-3512b707c035">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences>
    <Connection Alias="pushover" Type="community.pushover" Name="Pushover" />
  </ConnectionReferences>
  <CanvasState><![CDATA[{"viewport":{"x":520,"y":300,"zoom":0.85},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>